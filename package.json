{
	"name": "whatsapp-bulk-sender",
	"version": "1.0.0",
	"description": "WhatsApp Bulk Messaging Application using Baileys",
	"main": "backend/server.js",
	"scripts": {
		"dev": "concurrently \"npm run server\" \"npm run client\"",
		"server": "nodemon backend/server.js",
		"client": "cd frontend && npm run dev",
		"install-all": "npm install && cd frontend && npm install",
		"build": "cd frontend && npm run build"
	},
	"keywords": [
		"whatsapp",
		"baileys",
		"bulk-messaging"
	],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@whiskeysockets/baileys": "^6.7.8",
		"express": "^4.18.2",
		"socket.io": "^4.7.2",
		"cors": "^2.8.5",
		"multer": "^1.4.5-lts.1",
		"csv-parser": "^3.0.0",
		"qrcode": "^1.5.3",
		"pino": "^8.16.2",
		"node-cache": "^5.1.2"
	},
	"devDependencies": {
		"nodemon": "^3.0.1",
		"concurrently": "^8.2.2"
	}
}
